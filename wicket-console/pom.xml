<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ru.ydn.wicket.wicket-console</groupId>
    <artifactId>wicket-console-parent</artifactId>
    <version>1.4-SNAPSHOT</version>
  </parent>
  <groupId>ru.ydn.wicket.wicket-console</groupId>
  <artifactId>wicket-console</artifactId>
  <name>wicket-console</name>
  <description>Ajax script console component for Apache Wicket: pluggable script engines (JSR-223 or custom), per-session history, Wicket DebugBar panel</description>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
    </dependency>
    <dependency>
	    <groupId>org.apache.wicket</groupId>
	    <artifactId>wicket-core</artifactId>
    </dependency>
    <dependency>
	    <groupId>org.apache.wicket</groupId>
	    <artifactId>wicket-extensions</artifactId>
    </dependency>
    <dependency>
		<groupId>javax.servlet</groupId>
		<artifactId>javax.servlet-api</artifactId>
		<scope>provided</scope>
	</dependency>
    <dependency>
	    <groupId>org.apache.wicket</groupId>
	    <artifactId>wicket-devutils</artifactId>
	    <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
  	<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**</include>
				</includes>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
			<testResource>
				<directory>src/test/java</directory>
				<includes>
					<include>**</include>
				</includes>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</testResource>
		</testResources>
		<plugins>
			<!-- Library hygiene (REFRESH_PLAN.md D10): consumers choose their logging backend and their script engines,
			     so none may reach this jar's compile/runtime classpath. Test scope is allowed. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-library-hygiene</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<message>No logging binding and no script engine in the library (compile/runtime scope): see REFRESH_PLAN.md D4/D10</message>
									<excludes>
										<!-- groupId:artifactId:version:type:scope -->
										<exclude>org.slf4j:slf4j-log4j12:*:*:compile</exclude>
										<exclude>org.slf4j:slf4j-log4j12:*:*:runtime</exclude>
										<exclude>org.slf4j:slf4j-reload4j:*:*:compile</exclude>
										<exclude>org.slf4j:slf4j-reload4j:*:*:runtime</exclude>
										<exclude>org.slf4j:slf4j-simple:*:*:compile</exclude>
										<exclude>org.slf4j:slf4j-simple:*:*:runtime</exclude>
										<exclude>org.slf4j:slf4j-jdk14:*:*:compile</exclude>
										<exclude>org.slf4j:slf4j-jdk14:*:*:runtime</exclude>
										<exclude>org.slf4j:slf4j-nop:*:*:compile</exclude>
										<exclude>org.slf4j:slf4j-nop:*:*:runtime</exclude>
										<exclude>org.apache.logging.log4j:log4j-slf4j-impl:*:*:compile</exclude>
										<exclude>org.apache.logging.log4j:log4j-slf4j-impl:*:*:runtime</exclude>
										<exclude>org.apache.logging.log4j:log4j-slf4j2-impl:*:*:compile</exclude>
										<exclude>org.apache.logging.log4j:log4j-slf4j2-impl:*:*:runtime</exclude>
										<exclude>org.apache.logging.log4j:log4j-core:*:*:compile</exclude>
										<exclude>org.apache.logging.log4j:log4j-core:*:*:runtime</exclude>
										<exclude>ch.qos.logback:*:*:*:compile</exclude>
										<exclude>ch.qos.logback:*:*:*:runtime</exclude>
										<exclude>log4j:log4j:*:*:compile</exclude>
										<exclude>log4j:log4j:*:*:runtime</exclude>
										<exclude>ch.qos.reload4j:*:*:*:compile</exclude>
										<exclude>ch.qos.reload4j:*:*:*:runtime</exclude>
										<exclude>org.graalvm.js:*:*:*:compile</exclude>
										<exclude>org.graalvm.js:*:*:*:runtime</exclude>
										<exclude>org.graalvm.polyglot:*:*:*:compile</exclude>
										<exclude>org.graalvm.polyglot:*:*:*:runtime</exclude>
										<exclude>org.openjdk.nashorn:*:*:*:compile</exclude>
										<exclude>org.openjdk.nashorn:*:*:*:runtime</exclude>
										<exclude>org.mozilla:rhino-engine:*:*:compile</exclude>
										<exclude>org.mozilla:rhino-engine:*:*:runtime</exclude>
									</excludes>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
  </build>
</project>
